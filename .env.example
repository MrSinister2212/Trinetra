# TRINETRA OSINT Platform - Environment Configuration

# Core Application
PROJECT_NAME="TRINETRA OSINT Platform"
VERSION="1.0.0"
SECRET_KEY="replace-this-with-a-random-cryptographic-hex-string-for-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Storage (SQLite default, PostgreSQL supported)
DATABASE_URL="sqlite+aiosqlite:///./trinetra.db"
# DATABASE_URL="postgresql+asyncpg://trinetra_user:trinetra_pass@localhost:5432/trinetra"

# Tor SOCKS Proxy Configuration
TOR_SOCKS_PROXY="socks5h://127.0.0.1:9050"
TOR_CHECK_URL="https://check.torproject.org/api/ip"
USE_TOR_PROXY=false
TRINETRA_TEST_MODE=0

# Optional Search Engine & Threat Intelligence APIs
# (System falls back automatically to open public directories and archive indices if omitted)
HIBP_API_KEY=""
GOOGLE_CSE_KEY=""
GOOGLE_CSE_CX=""
BRAVE_SEARCH_API_KEY=""
SEARXNG_URL="https://searx.be"

# Rate Limiting & Target Cooldown
RATE_LIMIT_COOLDOWN_SECONDS=5
MAX_REQUESTS_PER_MINUTE=60
